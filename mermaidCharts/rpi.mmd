flowchart LR
    subgraph RPI[Raspberry Pi]
        
        subgraph L1[<b>Physical Interface Layer</b>]
            
            
            PI_Board[OpenCR board]
            PI_MC[Motor Controller]
            PI_Mot[Motor Interface]
            PI_Board -- "controls" --> PI_MC -- "PWM signals" --> PI_Mot
        end
        subgraph L2[<b>Communication Layer</b>]
            PI_OPENCR[Turtlebot3 driver]
            PI_MQTT[Mosquitto Broker]
            PI_ROS[ROS Daemon]
            PI_Client[MQTT Client]
        end
        subgraph L3[<b>Processing Layer</b>]
            
            PI_Bridge[MQTT-ROS Bridge]
        end
    end

    L2 ~~~~~~ L3
    
    PI_OPENCR -- "Motor velocity" --> PI_Board
    PI_Client ~~~~
    PI_MQTT -- "subscribes Motor velocity" --> PI_Client
    PI_MQTT ~~~~ 
    PI_Client -- "positional commands" --> PI_Bridge
    PI_Bridge ~~~~ PI_Client
    PI_Bridge -- "publishes <br> Motor velocity" --> PI_ROS

    PI_ROS -- "subscribes <br> Motor velocity" --> PI_OPENCR
    
    PI_ROS -- "subscribes: <br> Joint state" --> PI_Bridge 

    PI_OPENCR-- "publishes: <br> Joint state" --> PI_ROS 
    PI_Board -- "Joint state" --> PI_OPENCR
    