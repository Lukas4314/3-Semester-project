#include "I2sInterface.hpp"
#include "esp_timer.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/queue.h"
#include "driver/spi_slave.h"
#include "esp_log.h"

// SPI pins
#define SPI_MISO GPIO_NUM_19
#define SPI_MOSI GPIO_NUM_23
#define SPI_SCLK GPIO_NUM_18
#define SPI_CS GPIO_NUM_5
#define SPI_HOST_VAR SPI2_HOST

// === Pin definitions ===
#define I2S0_BCLK GPIO_NUM_26
#define I2S0_LRCLK GPIO_NUM_25
#define I2S0_DIN GPIO_NUM_22

#define I2S1_BCLK GPIO_NUM_16
#define I2S1_LRCLK GPIO_NUM_4
#define I2S1_DIN GPIO_NUM_32

#define MIC1_SEL_PIN GPIO_NUM_13
#define MIC1_SEL_VALUE 0
#define MIC2_SEL_PIN GPIO_NUM_14
#define MIC2_SEL_VALUE 1
#define MIC3_SEL_PIN GPIO_NUM_27
#define MIC3_SEL_VALUE 0

#define DATA_READY_GPIO GPIO_NUM_21 // safe, free

#define SAMPLE_RATE 16000
#define NUM_I2S_BUFFERS 10
#define BUFFER_SIZE 1024

// === Protocol Constants ===
#define FRAME_SIZE 4096  // Align with SPI_MAX_CHUNK
#define HEADER_FIRST_FRAME  0x01
#define HEADER_LAST_FRAME   0x02
#define RESP_QUERY_HEADER   0x81
#define RESP_ERROR          0xFF


QueueHandle_t i2sQueue;

#define BUFFER_SIZE_TOTAL (BUFFER_SIZE * 3 + 4)

static int16_t mic_data[NUM_I2S_BUFFERS][BUFFER_SIZE_TOTAL]; // 3 Mics

// SPI slave buffer for DMA transactions

#define SPI_FRAME_HEADER_0 0xAA
#define SPI_FRAME_HEADER_1 0x55
#define SPI_MAX_CHUNK 4096

uint8_t spiHeader[4];
uint8_t spiSlaveBuf[SPI_MAX_CHUNK];
uint8_t spiSlaveBuf2[SPI_MAX_CHUNK];

static DRAM_ATTR I2sInterface i2s0;
static DRAM_ATTR I2sInterface i2s1;

bool ready = false;

static bool buffer_ready[NUM_I2S_BUFFERS] = {false};
static uint16_t buffer_ids[NUM_I2S_BUFFERS] = {0};
static uint16_t next_packet_id = 0;

struct I2SBuffer
{
    uint8_t index;
    size_t length; // bytes
};

// Initialize SPI as slave
bool initSPISlave()
{
    spi_bus_config_t buscfg = {};
    buscfg.miso_io_num = SPI_MISO;
    buscfg.mosi_io_num = SPI_MOSI;
    buscfg.sclk_io_num = SPI_SCLK;
    buscfg.quadhd_io_num = -1;
    buscfg.quadwp_io_num = -1;
    buscfg.max_transfer_sz = SPI_MAX_CHUNK;

    spi_slave_interface_config_t slvcfg = {};
    slvcfg.spics_io_num = SPI_CS;
    slvcfg.queue_size = 3;
    slvcfg.mode = 0; // SPI mode 0
    slvcfg.flags = 0;

    esp_err_t ret = spi_slave_initialize(SPI_HOST_VAR, &buscfg, &slvcfg, 1);
    if (ret != ESP_OK)
    {
        ESP_LOGE("SPI", "Slave init failed: %d", ret);
        return false;
    }
    return true;
}

// Setup function
void setup()
{
    // Mic select pins
    gpio_set_direction(MIC1_SEL_PIN, GPIO_MODE_OUTPUT);
    gpio_set_direction(MIC2_SEL_PIN, GPIO_MODE_OUTPUT);
    gpio_set_direction(MIC3_SEL_PIN, GPIO_MODE_OUTPUT);
    gpio_set_level(MIC1_SEL_PIN, MIC1_SEL_VALUE);
    gpio_set_level(MIC2_SEL_PIN, MIC2_SEL_VALUE);
    gpio_set_level(MIC3_SEL_PIN, MIC3_SEL_VALUE);

    // Configure as output
    gpio_config_t io_conf = {};
    io_conf.pin_bit_mask = 1ULL << DATA_READY_GPIO;
    io_conf.mode = GPIO_MODE_OUTPUT;
    io_conf.pull_down_en = GPIO_PULLDOWN_DISABLE;
    io_conf.pull_up_en = GPIO_PULLUP_DISABLE;
    gpio_config(&io_conf);
    // Default LOW
    gpio_set_level(DATA_READY_GPIO, 0);

    // I2S interfaces
    i2s0 = I2sInterface(I2S_NUM_0, I2S_ROLE_MASTER, I2S_DATA_BIT_WIDTH_16BIT,
                        I2S_SLOT_MODE_STEREO, GPIO_NUM_NC, I2S0_BCLK, I2S0_LRCLK, I2S0_DIN,
                        I2S_STD_SLOT_BOTH, SAMPLE_RATE, 0);
    i2s1 = I2sInterface(I2S_NUM_1, I2S_ROLE_SLAVE, I2S_DATA_BIT_WIDTH_16BIT,
                        I2S_SLOT_MODE_MONO, GPIO_NUM_NC, I2S1_BCLK, I2S1_LRCLK, I2S1_DIN,
                        I2S_STD_SLOT_LEFT, SAMPLE_RATE, 1);

    if (!initSPISlave())
    {
        printf("SPI slave init failed\n");
        while (1)
            ;
    }

    i2sQueue = xQueueCreate(NUM_I2S_BUFFERS - 1, sizeof(I2SBuffer));

    printf("Setup complete\n");

    if (!i2s1.begin())
    {
        printf("I2S1 init failed\n");
        while (1)
            ;
    }

    if (!i2s0.begin())
    {
        printf("I2S init failed\n");
        while (1)
            ;
    }
}

// I2S capture task
void i2sTask(void *param)
{
    uint32_t counter0 = 0;
    uint32_t counter1 = 0;
    uint8_t i2s0Idx = 0;

    const size_t stereoSize = BUFFER_SIZE * 2;
    const size_t monoSize = BUFFER_SIZE;

    int16_t temp0[stereoSize];
    int16_t temp1[monoSize];

    while (true)
    {
        size_t bytesRead0 = i2s0.readSamples(temp0, stereoSize * sizeof(int16_t));
        size_t bytesRead1 = i2s1.readSamples(temp1, monoSize * sizeof(int16_t));

        if (bytesRead0 != stereoSize * sizeof(int16_t))
        {
            printf("I2S0 read size mismatch: %d bytes\n", bytesRead0);
        }
        if (bytesRead1 != monoSize * sizeof(int16_t))
        {
            printf("I2S1 read size mismatch: %d bytes\n", bytesRead1);
        }

        uint8_t buf0 = i2s0Idx;
        i2s0Idx = (i2s0Idx + 1) % NUM_I2S_BUFFERS;

        if (i2s0.counterOffset > 0)
        {
            counter0 += i2s0.counterOffset * stereoSize;
            printf("I2S0 counter offset applied: %d\n", i2s0.counterOffset);
            i2s0.counterOffset = 0;
        }
        if (i2s1.counterOffset > 0)
        {
            counter1 += i2s1.counterOffset * monoSize;
            printf("I2S1 counter offset applied: %d\n", i2s1.counterOffset);
            i2s1.counterOffset = 0;
        }

        // Store counters
        mic_data[buf0][0] = (int16_t)(counter0 & 0xFFFF);
        mic_data[buf0][1] = (int16_t)(counter0 >> 16);
        mic_data[buf0][BUFFER_SIZE * 2 + 2] = (int16_t)(counter1 & 0xFFFF);
        mic_data[buf0][BUFFER_SIZE * 2 + 3] = (int16_t)(counter1 >> 16);

        memcpy(mic_data[buf0] + 2, temp0, bytesRead0);
        memcpy(mic_data[buf0] + BUFFER_SIZE * 2 + 4, temp1, bytesRead1);
        
        buffer_ready[buf0] = true;
        buffer_ids[buf0] = next_packet_id++;
        
        // Wrap ID if needed
        if (next_packet_id >= 65535) next_packet_id = 0;

        // Queue buffers for SPI task
        I2SBuffer msg0 = {buf0, (bytesRead0 + 4 + bytesRead1 + 4)}; // 2 counters * 2 bytes

        uint8_t err = xQueueSend(i2sQueue, &msg0, 0);
        if (err != pdTRUE)
        {
            // Queue full, overflow
            //printf("Queue full, idx dropped: %d\n", buf0);
        }

        counter0++;
        counter1++;
    }
}

// RESPONSE FORMAT for CMD_GET_PACKET_INFO (flexible!)
// [HEADER][OPTION_BYTES][DATA_SIZE_4B][COUNTER0_4B][COUNTER1_4B][TIMESTAMP_4B]...



// Simplified SPI Slave Task - FIXED VERSION
void spiSlaveTask(void *param) {
    uint8_t command;
    spi_slave_transaction_t trans = {};
    
    printf("SPI Slave Task Started\n");
    
    while (true) {
        // === 1. WAIT FOR COMMAND ===
        trans.length = 8;  // 1 byte command
        trans.rx_buffer = &command;
        trans.tx_buffer = NULL;
        esp_err_t ret = spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
        
        if (ret != ESP_OK) {
            printf("SPI command receive error: %d\n", ret);
            continue;
        }
        
        printf("Received command: 0x%02x\n", command);
        
        // === 2. PROCESS COMMAND ===
        if (command == 0x01) {  // QUERY: How many packets ready?
            // Count ready buffers
            uint8_t ready_count = 0;
            for (int i = 0; i < NUM_I2S_BUFFERS; i++) {
                if (buffer_ready[i]) ready_count++;
            }
            
            // DEBUG: Print what we're sending
            printf("QUERY: %d packets ready, sending [0x81, 0x%02x]\n", ready_count, ready_count);
            
            // Send response: [HEADER][COUNT]
            uint8_t response[2] = {0x81, ready_count};  // USE 0x81 NOT RESP_QUERY_HEADER
            trans.length = 2 * 8;
            trans.tx_buffer = response;
            trans.rx_buffer = NULL;
            spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
            
            printf("QUERY response sent\n");
            
        } else if (command == 0x02) {  // REQUEST: Send next available packet
            // Find next ready buffer
            int8_t buffer_index = -1;
            for (int i = 0; i < NUM_I2S_BUFFERS; i++) {
                if (buffer_ready[i]) {
                    buffer_index = i;
                    break;
                }
            }
            
            if (buffer_index == -1) {
                // No data available
                printf("ERROR: No packets available\n");
                uint8_t error[2] = {0xFF, 0x01}; // 0xFF = ERROR, 0x01 = no data
                trans.length = 2 * 8;
                trans.tx_buffer = error;
                spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
                continue;
            }
            
            uint16_t packet_id = buffer_ids[buffer_index];
            int16_t* audio_data = mic_data[buffer_index];
            
            // DEBUG: Calculate actual sizes
            size_t total_audio_bytes = BUFFER_SIZE_TOTAL * sizeof(int16_t);
            printf("Sending packet %d (buffer %d): %zu bytes total\n", 
                   packet_id, buffer_index, total_audio_bytes);
            
            // === FRAME 1: First 4095 bytes of audio data ===
            uint8_t frame1[4096];  // Use literal 4096, not FRAME_SIZE
            frame1[0] = 0x01;  // Header for first frame
            
            // Copy first 4095 bytes
            size_t frame1_data_size = 4095;
            if (total_audio_bytes < frame1_data_size) {
                frame1_data_size = total_audio_bytes;
            }
            
            memcpy(&frame1[1], audio_data, frame1_data_size);
            
            // DEBUG
            printf("Frame 1: header=0x01, data=%zu bytes\n", frame1_data_size);
            printf("  First 8 audio bytes: ");
            for (int i = 0; i < 8 && i < frame1_data_size; i++) {
                printf("%02x ", ((uint8_t*)audio_data)[i]);
            }
            printf("\n");
            
            trans.length = 4096 * 8;  // Always send full 4096 bytes
            trans.tx_buffer = frame1;
            trans.rx_buffer = NULL;
            spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
            
            // === FRAME 2: Remaining data + Packet ID ===
            size_t remaining_bytes = total_audio_bytes - frame1_data_size;
            uint8_t frame2[4096];  // We'll use only 2058 bytes
            
            frame2[0] = 0x02;      // Header for last frame
            frame2[1] = packet_id & 0xFF;      // ID LSB
            frame2[2] = (packet_id >> 8) & 0xFF; // ID MSB
            
            // Copy remaining audio data
            if (remaining_bytes > 0) {
                memcpy(&frame2[3], (uint8_t*)audio_data + frame1_data_size, remaining_bytes);
            }
            
            // Calculate frame2 used size: header(1) + ID(2) + data
            size_t frame2_used = 3 + remaining_bytes;
            
            // DEBUG
            printf("Frame 2: header=0x02, ID=%d, remaining=%zu bytes\n", 
                   packet_id, remaining_bytes);
            printf("  Frame 2 total: %zu bytes\n", frame2_used);
            
            // Send second frame (EXACT size Python expects: 2058 bytes)
            // ESP32 will pad with zeros if frame2_used < 2058
            trans.length = 2058 * 8;  // FIXED: Always send 2058 bytes
            trans.tx_buffer = frame2;
            spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
            
            // Mark buffer as consumed
            buffer_ready[buffer_index] = false;
            
            printf("Packet %d sent successfully\n\n", packet_id);
            
        } else {
            // Unknown command
            printf("ERROR: Unknown command 0x%02x\n", command);
            uint8_t error[2] = {0xFF, 0x02}; // 0xFF = ERROR, 0x02 = unknown command
            trans.length = 2 * 8;
            trans.tx_buffer = error;
            spi_slave_transmit(SPI_HOST_VAR, &trans, portMAX_DELAY);
        }
    }
}

extern "C" void app_main(void)
{
    setup();
    printf("Setup complete, starting tasks...\n");

    xTaskCreatePinnedToCore(i2sTask, "I2S_Task", 8192 * 2, nullptr, 5, nullptr, 1);
    xTaskCreatePinnedToCore(spiSlaveTask, "SPI_Slave_Task", 4096 * 4, nullptr, 5, nullptr, 0);
}
